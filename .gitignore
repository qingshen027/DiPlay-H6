# Never commit credential containers or installable distribution artifacts.
*.pk8
*.p7b
*.p12
*.pfx
*.pem
*.key
*.apk
*.aab

# ---- H6 adaptation: extra guards ----
# Source archives and verification values are build outputs of
# 03-脚本/build-source-release.py, not repository content.
DiPlay-H6-source-*.zip
DiPlay-H6-source-*.zip.sha256.txt

# Anything that looks like a Chinese password note must never enter Git.
密码*.txt
*口令*.txt
